# --- LLM 後端切換 ---
LLM_BACKEND=ollama          # ollama | vllm

# --- Ollama（LLM_BACKEND=ollama 時用）---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODE=/api/generate
OLLAMA_MODEL=gpt-oss:20b

# --- vLLM（LLM_BACKEND=vllm 時用；在 Linux/GPU 上 `vllm serve <HF模型> --port 8001`）---
VLLM_URL=http://127.0.0.1:8001
VLLM_MODEL=
